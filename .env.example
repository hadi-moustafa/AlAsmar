# Postgres connection string (Neon via Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob token for image uploads (set automatically when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=

# Admin panel password (/admin)
ADMIN_PASSWORD=change-me
# Optional: separate secret for signing admin sessions (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
