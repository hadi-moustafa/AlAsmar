# The Google Sheet holding the menu (full URL or just the id).
# The sheet must be a native Google Sheet shared as "Anyone with the link → Viewer".
GOOGLE_SHEET_ID=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# --- Admin panel (/admin) ---
# Login for the admin panel.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me
# Google service account JSON key (whole file, one line). Share the sheet with its email as Editor.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Vercel Blob token for photo uploads (added automatically when you connect a Blob store).
BLOB_READ_WRITE_TOKEN=
